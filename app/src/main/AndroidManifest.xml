<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.ClubDeportivoDAM">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity android:name=".LoginActivity" />
        <activity android:name=".CreateAccountActivity" />
        <activity android:name=".WelcomeActivity" />

        <activity android:name=".PanelGestionActivity" />
        <activity android:name=".SociosActivity" />
        <activity android:name=".VencimientosActivity" />
        <activity android:name=".ActividadesActivity" />

        <activity android:name=".PaseDiarioActivity" />
        <activity android:name=".PaseActividadActivity" />
        <activity android:name=".CarnetSociosActivity" />

        <activity android:name=".RegistroSocioActivity" />
        <activity android:name=".PerfilSocioActivity" />
        <activity android:name=".GestionPagosActivity" />
        <activity android:name=".ListadoPagosActivity"  />

    </application>

    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" />

</manifest>